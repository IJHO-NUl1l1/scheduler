    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
